# Everything is optional. With nothing set WakeSet runs: each visitor gets a
# private routine tied to a cookie, can make an account to sync devices, and
# Spotter (the assistant) is switched off.

# Spotter. People connect their own Claude API key on the Spotter page. Set a
# key here instead to switch him on for everyone, paid for by the site.
ANTHROPIC_API_KEY=
# Model Spotter uses. Default: claude-opus-5-5.
WAKESET_MODEL=
# Spotter messages allowed per person per day (default 40), and for the whole
# site per day (default 2000). These bound what the key can be made to spend.
WAKESET_AI_DAILY=
WAKESET_AI_DAILY_TOTAL=

# Signs the cookie that says who a visitor is, and encrypts the API keys
# people connect. Set 32+ random characters in production, and never change
# it afterwards: saved keys would become unreadable and everyone signed out. Left empty, one is generated and kept in the database file.
WAKESET_SECRET=

# Where the database file lives. Default: .data
WAKESET_DATA_DIR=
